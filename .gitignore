# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example no lleva valores, solo explica cuales hacen falta.
!.env.example
# .env.production se puede versionar porque solo debe contener las dos
# NEXT_PUBLIC_* de Supabase, que de todas formas acaban dentro del JS que
# descarga cualquier visitante. Ver supabase/README.md.
# NO pongas aqui nada que no pueda ser publico (jamas la service_role key).
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
cloudflare-env.d.ts
